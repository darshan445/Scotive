# Canonical public site URL (no trailing slash) — used for metadata, sitemap, robots, JSON-LD
# Production example: https://www.scotive.com
NEXT_PUBLIC_SITE_URL=https://www.scotive.com

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: sync-state poll interval (ms)
# NEXT_PUBLIC_SYNC_STATE_POLL_MS=120000
