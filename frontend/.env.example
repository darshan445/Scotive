# Canonical public site URL (no trailing slash) — used for metadata, sitemap, robots, JSON-LD.
# Production MUST be https://www.scotive.com (apex scotive.com is auto-normalized to www in code).
NEXT_PUBLIC_SITE_URL=https://www.scotive.com

# Backend API base URL (no trailing slash). Rails API is :3000; Next is :3001.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:3000

# Optional: sync-state poll interval (ms)
# NEXT_PUBLIC_SYNC_STATE_POLL_MS=120000
