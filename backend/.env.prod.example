# Production secrets. Copy to backend/.env.prod and fill in.
# Gitignored: backend/.env.prod  |  committed: this file
# Docker Compose injects the filled file; it is not baked into the image.

RAILS_ENV=production
PORT=3000
# true only behind a TLS-terminating proxy (otherwise http health checks 301).
FORCE_SSL=false

# Overridden by docker-compose.prod.yml to use the `db` / `redis` hostnames.
# If you change the password, also set POSTGRES_PASSWORD for compose.
DATABASE_URL=postgres://scotive:replace-db-password@db:5432/scotive
REDIS_URL=redis://redis:6379/0

SECRET_KEY_BASE=replace-with-hex
DEVISE_JWT_SECRET_KEY=replace-with-hex

FRONTEND_URL=https://www.scotive.com
PUBLIC_API_URL=https://api.scotive.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://api.scotive.com/api/qbo/oauth/callback
QBO_ENV=production
QBO_WEBHOOK_URL=https://api.scotive.com/api/qbo/webhooks
QBO_WEBHOOK_VERIFIER_TOKEN=
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

