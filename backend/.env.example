# Single env file. Rails env files still exist (Rails requires them) but
# secrets and URLs live here. Docker Compose overrides DATABASE_URL / REDIS_URL
# to service hostnames.

RAILS_ENV=development
PORT=3000

# Local (rvm) against docker-compose db/redis on published ports:
DATABASE_URL=postgres://scotive:scotive@localhost:5432/scotive
TEST_DATABASE_URL=postgres://scotive:scotive@localhost:5432/scotive_test
REDIS_URL=redis://localhost:6379/0

SECRET_KEY_BASE=replace-with-hex
DEVISE_JWT_SECRET_KEY=replace-with-hex

FRONTEND_URL=http://localhost:3000

# Integrations (fill as you connect adapters)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost:3000
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/oauth/callback
QBO_ENV=sandbox
QBO_WEBHOOK_URL=http://localhost:3000/api/qbo/webhooks
QBO_WEBHOOK_VERIFIER_TOKEN=
ENCRYPTION_KEY=
