# MongoDB (required)
# Local uvicorn (no Docker): mongodb://localhost:27017
# docker compose: overridden to mongodb://mongo:27017 — leave as localhost for host runs
MONGO_URL=mongodb://localhost:27017
DB_NAME=scotive

# Auth
JWT_SECRET=replace-with-long-random-hex
ADMIN_EMAIL=admin@scotive.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Scotive Admin

# Unipile — Gmail connect + mail (Hosted Auth; no Google OAuth verification on our app)
# Dashboard → get DSN (https://apiXX.unipile.com:PORT) and API key
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX
UNIPILE_API_KEY=replace-with-unipile-api-key
# Public HTTPS URL of this API (required for hosted-auth notify + account_status webhook)
# Local: your ngrok URL. Prod: https://api.scotive.com
PUBLIC_API_URL=https://your-subdomain.ngrok-free.dev
# UNIPILE_NOTIFY_URL=https://your-subdomain.ngrok-free.dev/api/gmail/unipile/notify
UNIPILE_WEBHOOK_SECRET=replace-with-random-secret

# Legacy Google OAuth (unused for Gmail — kept only if you revert)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=

# QuickBooks Online OAuth — https://developer.intuit.com/
# Redirect URI must match the Intuit app exactly (use ngrok URL in local/sandbox).
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_REDIRECT_URI=https://your-subdomain.ngrok-free.dev/api/qbo/oauth/callback
QBO_ENV=sandbox
# Module 6 webhooks — same ngrok host; paste QBO_WEBHOOK_URL into Intuit Developer → Webhooks
QBO_WEBHOOK_URL=https://your-subdomain.ngrok-free.dev/api/qbo/webhooks
QBO_WEBHOOK_VERIFIER_TOKEN=

# Fernet key for encrypting Gmail/QBO refresh tokens
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Frontend origin (CORS, OAuth redirects, digest links)
FRONTEND_URL=http://localhost:3000

# Optional: extra CORS origins (comma-separated)
# CORS_ORIGINS=

# Background loops (production defaults below). Set an interval to 0 to disable that loop.
# Digest check interval is only how often we ask "is it anyone's digest hour?" —
# each user still gets at most one digest per day at their configured hour/timezone.
SYNC_INTERVAL_SECONDS=3600
ESCALATION_INTERVAL_SECONDS=3600
DIGEST_CHECK_INTERVAL_SECONDS=900

# Auto escalation ladder + post-chase follow-up drafts/banners (off for MVP).
# Manual draft-from-invoice still works. Set true to re-enable.
ENABLE_CHASING_TIMING=false

# Gmail fetch tuning (batch is always on; failed chunks fall back to per-message fetch)
GMAIL_BATCH_SIZE=50
GMAIL_FETCH_CONCURRENCY=18
GMAIL_FETCH_RETRIES=4
